PORT=3001
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=desi_dawat_menu
# Enable for managed/remote databases that require verified TLS.
DB_SSL=false
# Optional CA certificate path when the provider requires a private CA bundle.
DB_SSL_CA=
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# In production, ADMIN_PASSWORD must be a bcrypt hash. Plain text is development-only.
FRONTEND_ORIGIN=http://localhost:5173
# Use a durable, writable path outside the active deployment release in production.
UPLOAD_DIR=
# Set to the exact number of trusted reverse proxies in front of the API (often 1).
TRUST_PROXY_HOPS=0
# Keep the routing API key in the backend environment only.
OPENROUTESERVICE_API_KEY=replace-with-your-api-key
